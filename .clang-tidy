---
# ODE Coding Style Requirements (CSR) - clang-tidy configuration
#
# Reference: CSR.txt
#
# CSR Rule Mapping:
#
# ENFORCEABLE:
#   (I.2) No goto               -> cppcoreguidelines-avoid-goto, hicpp-avoid-goto
#   (I.1) One complex construct -> readability-function-cognitive-complexity (limit)
#   (I.5) Init with zero        -> cppcoreguidelines-init-variables
#   (I.6) No variable reuse     -> misc-const-correctness (partial)
#   (I.7) Params by value const -> readability-non-const-parameter (partial)
#   (II.3) Private fields only  -> misc-non-private-member-variables-in-classes
#
# PARTIALLY ENFORCEABLE (heuristic):
#   (I.3) Single exit point     -> No direct check; readability-function-cognitive-complexity
#                                  helps keep functions simple enough for single return
#   (I.1) Function complexity   -> readability-function-size (lines/statements/branches)
#
# NOT ENFORCEABLE BY CLANG-TIDY (require code review):
#   (I.2) No continue
#   (I.4) Zero value means failure
#   (I.8) Result assignment at end
#   (I.9) Reference params copied to locals
#   (II.1) Classes work with own fields
#   (II.2) No direct field access (use accessors)
#   (II.4) No code in constructors
#   (II.5) No code in callbacks
#   (II.6) No public virtual methods
#   (II.7) No logical level violations
#

Checks: >
  -*,
  cppcoreguidelines-avoid-goto,
  hicpp-avoid-goto,
  cppcoreguidelines-init-variables,
  misc-const-correctness,
  misc-non-private-member-variables-in-classes,
  readability-function-cognitive-complexity,
  readability-function-size,
  readability-non-const-parameter,
  bugprone-branch-clone,
  bugprone-macro-parentheses,
  bugprone-sizeof-expression,
  bugprone-suspicious-string-compare,
  bugprone-use-after-move,

  bugprone-*,
  cert-*,
  concurrency-*,
  clang-*,
  cppcoreguidelines-*,
  hicpp-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -clang-analyzer-*,
  -clang-diagnostic*,
  -clang-diagnostic-c++20-extensions,
  -clang-diagnostic-array-bounds,
  -clang-diagnostic-unneeded-internal-declaration,
  -clang-diagnostic-undef,
  -*-avoid-c-arrays,
  -*-avoid-goto,
  -*-member-init,
  -*-special-member-functions,
  -*-vararg,
  -*-no-malloc,
  -*-deprecated-headers,
  -bugprone-assignment-in-if-condition,
  -bugprone-casting-through-void,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-reserved-identifier,
  -bugprone-sizeof-expression,
  -cert-dcl37-c,
  -cert-dcl50-cpp,
  -cert-dcl51-cpp,
  -cert-dcl54-cpp,
  -cert-err33-c,
  -cert-err34-c,
  -cert-err52-cpp,
  -cert-flp30-c,
  -cert-int09-c,
  -cert-msc30-c,
  -cert-msc50-cpp,
  -concurrency-mt-unsafe,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-init-variables,
  -cppcoreguidelines-interfaces-global-init,
  -cppcoreguidelines-macro-usage,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -cppcoreguidelines-owning-memory,
  -cppcoreguidelines-prefer-member-initializer,
  -cppcoreguidelines-pro-bounds-array-to-pointer-decay,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-type-const-cast,
  -cppcoreguidelines-pro-type-cstyle-cast,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-static-cast-downcast,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-macro-to-enum,
  -hicpp-braces-around-statements,
  -hicpp-explicit-conversions,
  -hicpp-new-delete-operators,
  -hicpp-no-array-decay,
  -hicpp-no-assembler,
  -hicpp-signed-bitwise,
  -hicpp-use-emplace,
  -hicpp-use-auto,
  -hicpp-use-equals-default,
  -hicpp-uppercase-literal-suffix,
  -hicpp-use-nullptr,
  -misc-definitions-in-headers,
  -misc-header-include-cycle,
  -misc-include-cleaner,
  -misc-new-delete-overloads,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -misc-use-anonymous-namespace,
  -misc-use-internal-linkage,
  -performance-enum-size,
  -performance-no-int-to-ptr,
  -performance-unnecessary-value-param,
  -readability-avoid-uncon*,
  -readability-avoid-nested-conditional-operator,
  -readability-braces-around-statements,
  -readability-casting,
  -readability-container-data-pointer,
  -readability-convert-member-functions-to-static,
  -readability-else-after-return,
  -readability-identifier-length,
  -readability-implicit-bool-conversion,
  -readability-magic-numbers,
  -readability-math-missing-parentheses,
  -readability-non-const-parameter,
  -readability-qualified-auto,
  -readability-redundant-member-init,
  -readability-simplify-boolean-expr,
  -readability-uppercase-literal-suffix,
  -readability-use-anyofallof,
  -readability-incon*,
  -readability-use-std-min-max,
  -readability-isolate-declaration,
  -readability-enum-initial-value,
  -readability-suspicious-call-argument,
  -readability-use-concise-preprocessor-directives

WarningsAsErrors: >
  cppcoreguidelines-avoid-goto,
  hicpp-avoid-goto,

CheckOptions:
  # (I.1) One complex construction per function - keep functions small
  - key: readability-function-cognitive-complexity.Threshold
    value: 25
  - key: readability-function-size.LineThreshold
    value: 200
  - key: readability-function-size.StatementThreshold
    value: 100
  - key: readability-function-size.BranchThreshold
    value: 20
  - key: readability-function-size.ParameterThreshold
    value: 8
  - key: readability-function-size.NestingThreshold
    value: 5

  # (I.5) Variables initialized with zero
  - key: cppcoreguidelines-init-variables.IncludeStyle
    value: llvm

  # (II.3) Private fields only - flag protected/public member variables
  - key: misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic
    value: true

  # (I.6/I.7) Encourage const-correctness
  - key: misc-const-correctness.AnalyzeValues
    value: true
  - key: misc-const-correctness.AnalyzeReferences
    value: true
  - key: misc-const-correctness.WarnPointersAsValues
    value: false

  - key: misc-include-cleaner.MissingIncludes
    value: false
  - key: misc-include-cleaner.IgnoredHeaders
    value: ode/ode.h

HeaderFilterRegex: '(include/ode|include/drawstuff|ode/src|drawstuff/src)/.*\.h$'
...
